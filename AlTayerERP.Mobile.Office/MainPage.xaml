<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlTayerERP.Mobile.Office.MainPage"
             FlowDirection="RightToLeft"
             BackgroundColor="#F6F8FB"
             Title="تسجيل الدخول">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">
            <Label Text="منظومة الطائر"
                   FontSize="30"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   TextColor="#17324D" />
            <Label x:Name="StepTitleLabel"
                   Text="أدخل بيانات الحساب أولاً"
                   FontSize="17"
                   HorizontalTextAlignment="Center"
                   TextColor="#5B6B7A" />

            <Border Stroke="#D9E2EC" BackgroundColor="White" Padding="18" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout x:Name="CredentialsPanel" Spacing="12">
                        <Label Text="الشركة" TextColor="#35566F" />
                        <Border Stroke="#D9E2EC" Padding="4" StrokeShape="RoundRectangle 10">
                            <Picker x:Name="CompanyPicker"
                                    Title="اختر الشركة"
                                    ItemDisplayBinding="{Binding DisplayName}" />
                        </Border>
                        <Label x:Name="CompaniesStatusLabel"
                               Text="جاري تحميل الشركات..."
                               FontSize="12"
                               TextColor="#7A8896"
                               HorizontalTextAlignment="Center" />

                        <Entry x:Name="LoginNameEntry"
                               Placeholder="اسم المستخدم"
                               ReturnType="Next"
                               ClearButtonVisibility="WhileEditing" />
                        <Entry x:Name="PasswordEntry"
                               Placeholder="كلمة المرور"
                               IsPassword="True"
                               ReturnType="Done" />
                        <Button x:Name="LoadOptionsButton"
                                Text="متابعة واختيار الفرع والسنة"
                                HeightRequest="52"
                                CornerRadius="12"
                                IsEnabled="False"
                                Clicked="OnLoadOptionsClicked" />
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ContextPanel" Spacing="12" IsVisible="False">
                        <Label x:Name="UserWelcomeLabel"
                               FontSize="15"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="#17324D" />

                        <Border Stroke="#D9E2EC" Padding="4" StrokeShape="RoundRectangle 10">
                            <Picker x:Name="BranchPicker"
                                    Title="اختر الفرع"
                                    ItemDisplayBinding="{Binding DisplayName}" />
                        </Border>

                        <Border Stroke="#D9E2EC" Padding="4" StrokeShape="RoundRectangle 10">
                            <Picker x:Name="YearPicker"
                                    Title="اختر السنة المالية"
                                    ItemDisplayBinding="{Binding DisplayName}" />
                        </Border>

                        <Button x:Name="LoginButton"
                                Text="دخول"
                                HeightRequest="52"
                                CornerRadius="12"
                                Clicked="OnLoginClicked" />
                        <Button Text="رجوع لتعديل بيانات الحساب"
                                BackgroundColor="Transparent"
                                TextColor="#35566F"
                                Clicked="OnBackClicked" />
                    </VerticalStackLayout>

                    <Label x:Name="StatusLabel"
                           TextColor="#B42318"
                           HorizontalTextAlignment="Center"
                           IsVisible="False" />
                    <ActivityIndicator x:Name="BusyIndicator"
                                       IsVisible="False"
                                       IsRunning="False" />
                </VerticalStackLayout>
            </Border>

            <Label Text="يتصل التطبيق بخدمات النظام عبر API فقط"
                   FontSize="12"
                   HorizontalTextAlignment="Center"
                   TextColor="#7A8896" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
