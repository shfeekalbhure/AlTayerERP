<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlTayerERP.Mobile.Office.MainPage"
             FlowDirection="RightToLeft"
             BackgroundColor="#F6F8FB"
             Title="تسجيل الدخول">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">
            <Label Text="منظومة الطائر"
                   FontSize="30"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   TextColor="#17324D" />
            <Label Text="تسجيل الدخول الآمن"
                   FontSize="17"
                   HorizontalTextAlignment="Center"
                   TextColor="#5B6B7A" />

            <Border Stroke="#D9E2EC" BackgroundColor="White" Padding="18" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="12">
                    <Entry x:Name="CompanyEntry" Placeholder="رمز الشركة" ReturnType="Next" />
                    <Entry x:Name="BranchEntry" Placeholder="رقم الفرع" Keyboard="Numeric" ReturnType="Next" />
                    <Entry x:Name="YearEntry" Placeholder="رقم السنة المالية" Keyboard="Numeric" ReturnType="Next" />
                    <Entry x:Name="LoginNameEntry" Placeholder="اسم المستخدم" ReturnType="Next" />
                    <Entry x:Name="PasswordEntry" Placeholder="كلمة المرور" IsPassword="True" ReturnType="Done" />
                    <Label x:Name="StatusLabel" TextColor="#B42318" IsVisible="False" />
                    <ActivityIndicator x:Name="BusyIndicator" IsVisible="False" IsRunning="False" />
                    <Button x:Name="LoginButton"
                            Text="دخول"
                            HeightRequest="50"
                            CornerRadius="12"
                            Clicked="OnLoginClicked" />
                </VerticalStackLayout>
            </Border>

            <Label Text="يتصل التطبيق بخدمات النظام عبر API فقط"
                   FontSize="12"
                   HorizontalTextAlignment="Center"
                   TextColor="#7A8896" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
