<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlTayerERP.Mobile.Office.MainPage"
             FlowDirection="RightToLeft"
             BackgroundColor="#F6F8FB"
             Title="تسجيل الدخول">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">
            <Label Text="الطائر للبرمجيات"
                   FontSize="30"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   TextColor="#17324D" />
            <Label x:Name="StepTitleLabel"
                   Text="أدخل بيانات الحساب أولاً"
                   FontSize="17"
                   HorizontalTextAlignment="Center"
                   TextColor="#5B6B7A" />

            <Border Stroke="#D9E2EC" BackgroundColor="White" Padding="18" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout x:Name="CredentialsPanel" Spacing="12">
                        <Label Text="الشركة" TextColor="#35566F" />
                        <Border Stroke="#D9E2EC" BackgroundColor="White" Padding="4" StrokeShape="RoundRectangle 10">
                            <Picker x:Name="CompanyPicker"
                                    Title="اختر الشركة"
                                    TextColor="#17324D"
                                    TitleColor="#7A8896"
                                    BackgroundColor="White"
                                    ItemDisplayBinding="{Binding DisplayName}"
                                    SelectedIndexChanged="OnCredentialsChanged" />
                        </Border>
                        <Label x:Name="CompaniesStatusLabel"
                               Text="جاري تحميل الشركات..."
                               FontSize="12"
                               TextColor="#7A8896"
                               HorizontalTextAlignment="Center" />

                        <Entry x:Name="LoginNameEntry"
                               Placeholder="اسم المستخدم"
                               TextColor="#17324D"
                               PlaceholderColor="#7A8896"
                               BackgroundColor="White"
                               ReturnType="Next"
                               ClearButtonVisibility="WhileEditing"
                               TextChanged="OnCredentialsChanged" />
                        <Entry x:Name="PasswordEntry"
                               Placeholder="كلمة المرور"
                               TextColor="#17324D"
                               PlaceholderColor="#7A8896"
                               BackgroundColor="White"
                               IsPassword="True"
                               ReturnType="Done"
                               TextChanged="OnCredentialsChanged" />
                        <Button x:Name="LoadOptionsButton"
                                Text="متابعة واختيار الفرع والسنة"
                                TextColor="White"
                                BackgroundColor="#0B6B87"
                                HeightRequest="52"
                                CornerRadius="12"
                                IsEnabled="False"
                                Clicked="OnLoadOptionsClicked" />
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ContextPanel" Spacing="12" IsVisible="False">
                        <Label x:Name="UserWelcomeLabel"
                               FontSize="15"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="#17324D" />

                        <Border Stroke="#D9E2EC" BackgroundColor="White" Padding="4" StrokeShape="RoundRectangle 10">
                            <Picker x:Name="BranchPicker"
                                    Title="اختر الفرع"
                                    TextColor="#17324D"
                                    TitleColor="#7A8896"
                                    BackgroundColor="White"
                                    ItemDisplayBinding="{Binding DisplayName}"
                                    SelectedIndexChanged="OnContextChanged" />
                        </Border>

                        <Border Stroke="#D9E2EC" BackgroundColor="White" Padding="4" StrokeShape="RoundRectangle 10">
                            <Picker x:Name="YearPicker"
                                    Title="اختر السنة المالية"
                                    TextColor="#17324D"
                                    TitleColor="#7A8896"
                                    BackgroundColor="White"
                                    ItemDisplayBinding="{Binding DisplayName}"
                                    SelectedIndexChanged="OnContextChanged" />
                        </Border>

                        <Button x:Name="LoginButton"
                                Text="دخول"
                                TextColor="White"
                                BackgroundColor="#0B6B87"
                                HeightRequest="52"
                                CornerRadius="12"
                                IsEnabled="False"
                                Clicked="OnLoginClicked" />
                        <Button Text="رجوع لتعديل بيانات الحساب"
                                BackgroundColor="Transparent"
                                TextColor="#35566F"
                                Clicked="OnBackClicked" />
                    </VerticalStackLayout>

                    <Label x:Name="StatusLabel"
                           TextColor="#B42318"
                           HorizontalTextAlignment="Center"
                           IsVisible="False" />
                    <ActivityIndicator x:Name="BusyIndicator"
                                       Color="#0B6B87"
                                       IsVisible="False"
                                       IsRunning="False" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="DevelopmentConnectionPanel"
                    IsVisible="False"
                    Stroke="#D9E2EC"
                    BackgroundColor="White"
                    Padding="16"
                    StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="10">
                    <Label Text="إعداد اتصال التطوير"
                           FontAttributes="Bold"
                           TextColor="#17324D" />
                    <Picker x:Name="ConnectionModePicker"
                            Title="طريقة الاتصال"
                            SelectedIndexChanged="OnConnectionSettingsChanged">
                        <Picker.Items>
                            <x:String>تلقائي</x:String>
                            <x:String>USB</x:String>
                            <x:String>Wi-Fi</x:String>
                        </Picker.Items>
                    </Picker>
                    <Entry x:Name="WifiBaseAddressEntry"
                           Placeholder="عنوان Wi-Fi، مثال: 192.168.1.10"
                           Keyboard="Url"
                           TextChanged="OnConnectionSettingsChanged" />
                    <Entry x:Name="WifiPortEntry"
                           Placeholder="المنفذ"
                           Keyboard="Numeric"
                           TextChanged="OnConnectionSettingsChanged" />
                    <Button Text="اختبار الاتصال"
                            BackgroundColor="#0B6B87"
                            TextColor="White"
                            Clicked="OnTestConnectionClicked" />
                    <Label x:Name="ConnectionStatusLabel"
                           FontSize="12"
                           TextColor="#35566F" />
                    <Label x:Name="DevelopmentDatabaseLabel"
                           FontSize="11"
                           TextColor="#7A8896" />
                </VerticalStackLayout>
            </Border>

            <Label Text="يتصل التطبيق بخدمات النظام عبر API فقط"
                   FontSize="12"
                   HorizontalTextAlignment="Center"
                   TextColor="#7A8896" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
