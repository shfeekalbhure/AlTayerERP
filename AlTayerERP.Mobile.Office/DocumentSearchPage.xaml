<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlTayerERP.Mobile.Office.DocumentSearchPage"
             FlowDirection="RightToLeft"
             BackgroundColor="#F6F8FB"
             Title="بحث المستندات">
    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">
        <VerticalStackLayout Spacing="10">
            <Entry x:Name="QueryEntry" Placeholder="رقم المستند أو المرجع" BackgroundColor="White" TextColor="#17324D" PlaceholderColor="#7A8896" />
            <Picker x:Name="TypePicker" Title="نوع المستند" BackgroundColor="White" TextColor="#17324D" SelectedIndex="0">
                <Picker.Items>
                    <x:String>الكل</x:String>
                    <x:String>طلب صرف</x:String>
                    <x:String>سند قبض</x:String>
                    <x:String>سند صرف</x:String>
                    <x:String>قيد يومي</x:String>
                </Picker.Items>
            </Picker>
            <Button Text="بحث" BackgroundColor="#0B6B87" TextColor="White" CornerRadius="12" HeightRequest="48" Clicked="OnSearchClicked" />
            <ActivityIndicator x:Name="BusyIndicator" Color="#0B6B87" IsVisible="False" IsRunning="False" />
            <Label x:Name="MessageLabel" IsVisible="False" TextColor="#B42318" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
        <CollectionView x:Name="ResultsList" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnSelectionChanged">
            <CollectionView.EmptyView>
                <Label Text="لا توجد نتائج." HorizontalTextAlignment="Center" TextColor="#7A8896" Padding="20" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10" Padding="14" Stroke="#D9E2EC" BackgroundColor="White" StrokeShape="RoundRectangle 14">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="5">
                            <Label Text="{Binding DocumentNo}" FontAttributes="Bold" FontSize="16" TextColor="#17324D" />
                            <Label Grid.Column="1" Text="{Binding DocumentTypeDisplay}" TextColor="#0B6B87" />
                            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding PartyName}" TextColor="#35566F" />
                            <Label Grid.Row="2" Text="{Binding DocumentDate, StringFormat='التاريخ: {0:yyyy/MM/dd}'}" FontSize="12" TextColor="#7A8896" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding StatusDisplay}" FontSize="12" TextColor="#7A8896" />
                            <Label Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding LocalTotal, StringFormat='الإجمالي: {0:N2}'}" FontAttributes="Bold" TextColor="#17324D" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
