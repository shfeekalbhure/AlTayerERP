<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlTayerERP.Mobile.Office.ReceiptVoucherDetailsPage"
             FlowDirection="RightToLeft"
             BackgroundColor="#F6F8FB"
             Title="تفاصيل سند القبض">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">
            <Border BackgroundColor="#17324D" StrokeThickness="0" Padding="16" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="VoucherNoLabel" FontSize="21" FontAttributes="Bold" TextColor="White" />
                    <Label x:Name="PostingStatusLabel" FontSize="14" TextColor="#D9EAF7" />
                </VerticalStackLayout>
            </Border>
            <Border BackgroundColor="White" Stroke="#D9E2EC" Padding="14" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="ReceivedFromLabel" FontSize="17" FontAttributes="Bold" TextColor="#17324D" />
                    <Label x:Name="DateLabel" TextColor="#35566F" />
                    <Label x:Name="ReferenceLabel" TextColor="#35566F" />
                    <Label x:Name="CashAccountLabel" TextColor="#35566F" />
                    <Label x:Name="DescriptionLabel" TextColor="#35566F" />
                    <Label x:Name="TotalLabel" FontAttributes="Bold" TextColor="#17324D" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                <Button Grid.Row="0" Grid.Column="0" Text="مراجعة" BackgroundColor="#0B6B87" TextColor="White" Clicked="OnReviewClicked" />
                <Button Grid.Row="0" Grid.Column="1" Text="اعتماد" BackgroundColor="#17324D" TextColor="White" Clicked="OnApproveClicked" />
                <Button Grid.Row="1" Grid.Column="0" Text="إعادة للتصحيح" BackgroundColor="#B7791F" TextColor="White" Clicked="OnReturnClicked" />
                <Button x:Name="PostButton" Grid.Row="1" Grid.Column="1" Text="ترحيل" BackgroundColor="#18794E" TextColor="White" Clicked="OnPostClicked" />
                <Button x:Name="UnpostButton" Grid.Row="2" Grid.ColumnSpan="2" Text="فك الترحيل" BackgroundColor="#B42318" TextColor="White" IsVisible="False" Clicked="OnUnpostClicked" />
                <Button x:Name="JournalButton" Grid.Row="3" Grid.ColumnSpan="2" Text="استعراض القيد المحاسبي" BackgroundColor="#35566F" TextColor="White" IsVisible="False" Clicked="OnJournalClicked" />
            </Grid>

            <Label Text="التوزيع المحاسبي" FontSize="18" FontAttributes="Bold" TextColor="#17324D" />
            <VerticalStackLayout x:Name="LinesPanel" Spacing="10" />
            <ActivityIndicator x:Name="BusyIndicator" Color="#0B6B87" IsVisible="False" IsRunning="False" />
            <Label x:Name="MessageLabel" TextColor="#B42318" HorizontalTextAlignment="Center" IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
