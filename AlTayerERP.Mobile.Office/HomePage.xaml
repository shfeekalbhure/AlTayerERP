<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlTayerERP.Mobile.Office.HomePage"
             FlowDirection="RightToLeft"
             BackgroundColor="#F6F8FB"
             Title="الرئيسية">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Border BackgroundColor="#17324D" StrokeThickness="0" Padding="18" StrokeShape="RoundRectangle 18">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Label x:Name="WelcomeLabel" FontSize="22" FontAttributes="Bold" TextColor="White" />
                        <Label x:Name="ContextLabel" FontSize="13" TextColor="#D9EAF7" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="خروج" BackgroundColor="#B42318" TextColor="White" CornerRadius="10" HeightRequest="42" Clicked="OnLogoutClicked" />
                </Grid>
            </Border>

            <Label Text="الخدمات المتاحة" FontSize="19" FontAttributes="Bold" TextColor="#17324D" />
            <ActivityIndicator x:Name="PermissionsBusy" Color="#0B6B87" IsVisible="True" IsRunning="True" />
            <Label x:Name="PermissionsStatusLabel" Text="جاري تحميل الصلاحيات..." FontSize="12" HorizontalTextAlignment="Center" TextColor="#7A8896" />

            <VerticalStackLayout x:Name="ServicesPanel" Spacing="12" IsVisible="False">
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                    <Button x:Name="PaymentRequestButton" Grid.Row="0" Grid.Column="0" Text="طلب صرف" HeightRequest="90" BackgroundColor="White" TextColor="#17324D" BorderColor="#D9E2EC" BorderWidth="1" CornerRadius="14" IsVisible="False" Clicked="OnPaymentRequestsClicked" />
                    <Button x:Name="ReceiptVoucherButton" Grid.Row="0" Grid.Column="1" Text="سند قبض" HeightRequest="90" BackgroundColor="White" TextColor="#17324D" BorderColor="#D9E2EC" BorderWidth="1" CornerRadius="14" IsVisible="False" Clicked="OnReceiptVouchersClicked" />
                    <Button x:Name="PaymentVoucherButton" Grid.Row="1" Grid.Column="0" Text="سند صرف" HeightRequest="90" BackgroundColor="White" TextColor="#17324D" BorderColor="#D9E2EC" BorderWidth="1" CornerRadius="14" IsVisible="False" Clicked="OnPaymentVouchersClicked" />
                    <Button x:Name="JournalVoucherButton" Grid.Row="1" Grid.Column="1" Text="قيد يومي" HeightRequest="90" BackgroundColor="White" TextColor="#17324D" BorderColor="#D9E2EC" BorderWidth="1" CornerRadius="14" IsVisible="False" Clicked="OnJournalVouchersClicked" />
                    <Button x:Name="DocumentSearchButton" Grid.Row="2" Grid.Column="0" Text="بحث المستندات" HeightRequest="90" BackgroundColor="White" TextColor="#17324D" BorderColor="#D9E2EC" BorderWidth="1" CornerRadius="14" IsVisible="False" />
                    <Button x:Name="ApprovalRequestsButton" Grid.Row="2" Grid.Column="1" Text="طلبات الاعتماد" HeightRequest="90" BackgroundColor="White" TextColor="#17324D" BorderColor="#D9E2EC" BorderWidth="1" CornerRadius="14" IsVisible="False" />
                    <Button x:Name="TrialBalanceButton" Grid.Row="3" Grid.Column="0" Text="ميزان المراجعة" HeightRequest="90" BackgroundColor="White" TextColor="#17324D" BorderColor="#D9E2EC" BorderWidth="1" CornerRadius="14" IsVisible="False" />
                    <Button x:Name="GeneralLedgerButton" Grid.Row="3" Grid.Column="1" Text="الأستاذ العام" HeightRequest="90" BackgroundColor="White" TextColor="#17324D" BorderColor="#D9E2EC" BorderWidth="1" CornerRadius="14" IsVisible="False" />
                </Grid>
            </VerticalStackLayout>

            <Label x:Name="NoPermissionsLabel" Text="لا توجد خدمات مسموحة لهذا المستخدم." FontSize="13" HorizontalTextAlignment="Center" TextColor="#B42318" IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
