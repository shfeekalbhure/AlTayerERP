<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlTayerERP.Mobile.Office.HomePage"
             FlowDirection="RightToLeft"
             BackgroundColor="#F6F8FB"
             Title="الرئيسية">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Border BackgroundColor="#17324D" StrokeThickness="0" Padding="18" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="WelcomeLabel"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label x:Name="ContextLabel"
                           FontSize="13"
                           TextColor="#D9EAF7" />
                </VerticalStackLayout>
            </Border>

            <Label Text="الخدمات المتاحة"
                   FontSize="19"
                   FontAttributes="Bold"
                   TextColor="#17324D" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                <Button Grid.Row="0" Grid.Column="0" Text="طلب صرف" HeightRequest="90" BackgroundColor="White" TextColor="#17324D" BorderColor="#D9E2EC" BorderWidth="1" CornerRadius="14" />
                <Button Grid.Row="0" Grid.Column="1" Text="سند قبض" HeightRequest="90" BackgroundColor="White" TextColor="#17324D" BorderColor="#D9E2EC" BorderWidth="1" CornerRadius="14" />
                <Button Grid.Row="1" Grid.Column="0" Text="سند صرف" HeightRequest="90" BackgroundColor="White" TextColor="#17324D" BorderColor="#D9E2EC" BorderWidth="1" CornerRadius="14" />
                <Button Grid.Row="1" Grid.Column="1" Text="قيد يومي" HeightRequest="90" BackgroundColor="White" TextColor="#17324D" BorderColor="#D9E2EC" BorderWidth="1" CornerRadius="14" />
                <Button Grid.Row="2" Grid.Column="0" Text="التقارير" HeightRequest="90" BackgroundColor="White" TextColor="#17324D" BorderColor="#D9E2EC" BorderWidth="1" CornerRadius="14" />
                <Button Grid.Row="2" Grid.Column="1" Text="الإشعارات" HeightRequest="90" BackgroundColor="White" TextColor="#17324D" BorderColor="#D9E2EC" BorderWidth="1" CornerRadius="14" />
            </Grid>

            <Label Text="سيتم تفعيل كل خدمة حسب صلاحيات المستخدم عند استكمال الحزمة التالية."
                   FontSize="12"
                   HorizontalTextAlignment="Center"
                   TextColor="#7A8896" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
