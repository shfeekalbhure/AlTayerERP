<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlTayerERP.Mobile.Office.ReceiptVouchersPage"
             FlowDirection="RightToLeft"
             BackgroundColor="#F6F8FB"
             Title="سندات القبض">
    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Button Grid.Column="0" Text="+ جديد" BackgroundColor="#17324D" TextColor="White" Clicked="OnNewClicked" />
            <Entry Grid.Column="1" x:Name="VoucherNoEntry" Placeholder="بحث برقم السند" TextColor="#17324D" PlaceholderColor="#7A8896" BackgroundColor="White" />
            <Button Grid.Column="2" Text="بحث" BackgroundColor="#0B6B87" TextColor="White" Clicked="OnSearchClicked" />
        </Grid>
        <RefreshView x:Name="VouchersRefresh" Grid.Row="1" Refreshing="OnRefreshing">
            <CollectionView x:Name="VouchersList" SelectionMode="Single" SelectionChanged="OnSelectionChanged">
                <CollectionView.EmptyView>
                    <Label Text="لا توجد سندات قبض مطابقة." HorizontalTextAlignment="Center" TextColor="#7A8896" Padding="20" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10" Padding="14" Stroke="#D9E2EC" BackgroundColor="White" StrokeShape="RoundRectangle 14">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6">
                                <Label Text="{Binding VoucherNo}" FontAttributes="Bold" FontSize="16" TextColor="#17324D" />
                                <Label Grid.Column="1" Text="{Binding PostingStatus}" TextColor="#0B6B87" />
                                <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ReceivedFromName}" TextColor="#35566F" />
                                <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding VoucherDate, StringFormat='التاريخ: {0:yyyy/MM/dd}'}" FontSize="12" TextColor="#7A8896" />
                                    <Label Grid.Column="1" Text="{Binding LocalTotal, StringFormat='الإجمالي: {0:N2}'}" FontAttributes="Bold" TextColor="#17324D" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
