<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlTayerERP.Mobile.Office.NewPaymentRequestPage"
             FlowDirection="RightToLeft"
             BackgroundColor="#F6F8FB"
             Title="طلب صرف جديد">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="بيانات الطلب" FontSize="20" FontAttributes="Bold" TextColor="#17324D" />

            <Label x:Name="OpenPeriodLabel"
                   Text="جاري التحقق من الفترة المالية المفتوحة..."
                   FontSize="12"
                   TextColor="#7A8896"
                   HorizontalTextAlignment="Center" />
            <DatePicker x:Name="RequestDatePicker"
                        TextColor="#17324D"
                        BackgroundColor="White" />
            <Entry x:Name="BeneficiaryEntry" Placeholder="اسم المستفيد" TextColor="#17324D" PlaceholderColor="#7A8896" BackgroundColor="White" />
            <Entry x:Name="PartyIdEntry" Placeholder="رقم الطرف - اختياري" TextColor="#17324D" PlaceholderColor="#7A8896" BackgroundColor="White" />
            <Entry x:Name="ReferenceEntry" Placeholder="رقم المرجع - اختياري" TextColor="#17324D" PlaceholderColor="#7A8896" BackgroundColor="White" />
            <Editor x:Name="DescriptionEditor" Placeholder="البيان أو الغرض من طلب الصرف" TextColor="#17324D" PlaceholderColor="#7A8896" BackgroundColor="White" AutoSize="TextChanges" MinimumHeightRequest="90" />

            <Label Text="إضافة سطر صرف" FontSize="18" FontAttributes="Bold" TextColor="#17324D" Margin="0,8,0,0" />

            <Picker x:Name="AccountPicker" Title="اختر الحساب المدين" TextColor="#17324D" TitleColor="#7A8896" BackgroundColor="White" ItemDisplayBinding="{Binding DisplayName}" />
            <Picker x:Name="CostCenterPicker" Title="اختر مركز التكلفة - اختياري" TextColor="#17324D" TitleColor="#7A8896" BackgroundColor="White" ItemDisplayBinding="{Binding DisplayName}" />
            <Picker x:Name="CurrencyPicker" Title="اختر العملة" TextColor="#17324D" TitleColor="#7A8896" BackgroundColor="White" ItemDisplayBinding="{Binding DisplayName}" SelectedIndexChanged="OnCurrencyChanged" />
            <Entry x:Name="ExchangeRateEntry" Placeholder="سعر الصرف" Keyboard="Numeric" Text="1" TextColor="#17324D" PlaceholderColor="#7A8896" BackgroundColor="White" />
            <Entry x:Name="ForeignAmountEntry" Placeholder="المبلغ الأجنبي - صفر للعملة المحلية" Keyboard="Numeric" Text="0" TextColor="#17324D" PlaceholderColor="#7A8896" BackgroundColor="White" TextChanged="OnForeignAmountChanged" />
            <Entry x:Name="LocalAmountEntry" Placeholder="المبلغ المحلي" Keyboard="Numeric" TextColor="#17324D" PlaceholderColor="#7A8896" BackgroundColor="White" />
            <Editor x:Name="LineDescriptionEditor" Placeholder="وصف السطر" TextColor="#17324D" PlaceholderColor="#7A8896" BackgroundColor="White" AutoSize="TextChanges" MinimumHeightRequest="70" />

            <Button x:Name="AddLineButton"
                    Text="+ إضافة السطر"
                    HeightRequest="48"
                    CornerRadius="12"
                    BackgroundColor="#0B6B87"
                    TextColor="White"
                    Clicked="OnAddLineClicked" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <Label Text="تفاصيل الطلب" FontSize="18" FontAttributes="Bold" TextColor="#17324D" />
                <Label x:Name="TotalLabel" Grid.Column="1" Text="الإجمالي: 0.00" FontAttributes="Bold" TextColor="#17324D" />
            </Grid>

            <CollectionView x:Name="LinesList" SelectionMode="None" HeightRequest="280">
                <CollectionView.EmptyView>
                    <Label Text="لم تتم إضافة أي أسطر بعد." HorizontalTextAlignment="Center" TextColor="#7A8896" Padding="12" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="12" Stroke="#D9E2EC" BackgroundColor="White" StrokeShape="RoundRectangle 12">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4">
                                <Label Text="{Binding AccountDisplay}" FontAttributes="Bold" TextColor="#17324D" />
                                <Button Grid.Column="1" Text="حذف" FontSize="12" BackgroundColor="#B42318" TextColor="White" CornerRadius="8" Padding="10,4" CommandParameter="{Binding}" Clicked="OnRemoveLineClicked" />
                                <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding CurrencyDisplay}" TextColor="#5B6B7A" FontSize="12" />
                                <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding CostCenterDisplay}" TextColor="#7A8896" FontSize="12" />
                                    <Label Grid.Column="1" Text="{Binding LocalAmount, StringFormat='{0:N2}'}" FontAttributes="Bold" TextColor="#17324D" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                <Button Grid.Column="0" x:Name="SaveDraftButton" Text="حفظ مسودة" HeightRequest="52" CornerRadius="12" BackgroundColor="#0B6B87" TextColor="White" Clicked="OnSaveDraftClicked" />
                <Button Grid.Column="1" x:Name="SaveAndSubmitButton" Text="حفظ وإرسال" HeightRequest="52" CornerRadius="12" BackgroundColor="#17324D" TextColor="White" Clicked="OnSaveAndSubmitClicked" />
            </Grid>

            <ActivityIndicator x:Name="BusyIndicator" Color="#0B6B87" IsVisible="False" IsRunning="False" />
            <Label x:Name="StatusLabel" IsVisible="False" HorizontalTextAlignment="Center" TextColor="#B42318" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
