<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlTayerERP.Mobile.Office.TrialBalancePage"
             FlowDirection="RightToLeft"
             BackgroundColor="#F6F8FB"
             Title="ميزان المراجعة">
    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">
        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
            <DatePicker x:Name="FromDatePicker" BackgroundColor="White" TextColor="#17324D" />
            <DatePicker x:Name="ToDatePicker" Grid.Column="1" BackgroundColor="White" TextColor="#17324D" />
            <Button Grid.Column="2" Text="عرض" BackgroundColor="#0B6B87" TextColor="White" Clicked="OnLoadClicked" />
        </Grid>

        <Border Grid.Row="1" Padding="12" Stroke="#D9E2EC" BackgroundColor="White" StrokeShape="RoundRectangle 12">
            <VerticalStackLayout Spacing="4">
                <Label x:Name="PeriodTotalsLabel" Text="حركة الفترة: مدين 0.00 | دائن 0.00" FontAttributes="Bold" TextColor="#17324D" />
                <Label x:Name="ClosingTotalsLabel" Text="الرصيد الختامي: مدين 0.00 | دائن 0.00" TextColor="#35566F" />
            </VerticalStackLayout>
        </Border>

        <Grid Grid.Row="2">
            <CollectionView x:Name="RowsList">
                <CollectionView.EmptyView>
                    <Label Text="لا توجد أرصدة ضمن الفترة المحددة." HorizontalTextAlignment="Center" TextColor="#7A8896" Padding="20" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10" Padding="12" Stroke="#D9E2EC" BackgroundColor="White" StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding AccountCode}" FontAttributes="Bold" TextColor="#17324D" />
                                <Label Text="{Binding AccountName}" TextColor="#35566F" />
                                <Label Text="{Binding PeriodDebit, StringFormat='حركة مدين: {0:N2}'}" FontSize="12" TextColor="#7A8896" />
                                <Label Text="{Binding PeriodCredit, StringFormat='حركة دائن: {0:N2}'}" FontSize="12" TextColor="#7A8896" />
                                <Label Text="{Binding ClosingDebit, StringFormat='رصيد مدين: {0:N2}'}" FontSize="12" TextColor="#0B6B87" />
                                <Label Text="{Binding ClosingCredit, StringFormat='رصيد دائن: {0:N2}'}" FontSize="12" TextColor="#0B6B87" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <ActivityIndicator x:Name="BusyIndicator" IsVisible="False" IsRunning="False" Color="#0B6B87" VerticalOptions="Center" HorizontalOptions="Center" />
            <Label x:Name="MessageLabel" IsVisible="False" TextColor="#B42318" HorizontalTextAlignment="Center" VerticalOptions="End" />
        </Grid>
    </Grid>
</ContentPage>
