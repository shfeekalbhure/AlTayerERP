<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlTayerERP.Mobile.Office.PaymentRequestDetailsPage"
             FlowDirection="RightToLeft"
             BackgroundColor="#F6F8FB"
             Title="تفاصيل طلب الصرف">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">
            <Border BackgroundColor="#17324D" StrokeThickness="0" Padding="16" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="RequestNoLabel" FontSize="21" FontAttributes="Bold" TextColor="White" />
                    <Label x:Name="StatusLabel" FontSize="14" TextColor="#D9EAF7" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" Stroke="#D9E2EC" Padding="14" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="9">
                    <Label x:Name="BeneficiaryLabel" FontSize="17" FontAttributes="Bold" TextColor="#17324D" />
                    <Label x:Name="DateLabel" TextColor="#35566F" />
                    <Label x:Name="DescriptionLabel" TextColor="#35566F" />
                    <Label x:Name="TotalLabel" FontAttributes="Bold" TextColor="#17324D" />
                </VerticalStackLayout>
            </Border>

            <Label Text="تفاصيل الحسابات" FontSize="18" FontAttributes="Bold" TextColor="#17324D" />
            <VerticalStackLayout x:Name="LinesPanel" Spacing="10" />

            <Editor x:Name="ReasonEditor"
                    Placeholder="اكتب سبب الإجراء عند الحاجة"
                    AutoSize="TextChanges"
                    TextColor="#17324D"
                    PlaceholderColor="#7A8896"
                    BackgroundColor="White" />

            <VerticalStackLayout Spacing="10">
                <Button x:Name="SubmitButton" Text="إرسال للمراجعة" BackgroundColor="#0B6B87" TextColor="White" Clicked="OnSubmitClicked" IsVisible="False" />
                <Button x:Name="ReviewButton" Text="تمت المراجعة وإرسال للاعتماد" BackgroundColor="#0B6B87" TextColor="White" Clicked="OnReviewClicked" IsVisible="False" />
                <Button x:Name="ApproveButton" Text="اعتماد" BackgroundColor="#198754" TextColor="White" Clicked="OnApproveClicked" IsVisible="False" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button x:Name="ReturnButton" Grid.Column="0" Text="إعادة" BackgroundColor="#B7791F" TextColor="White" Clicked="OnReturnClicked" IsVisible="False" />
                    <Button x:Name="RejectButton" Grid.Column="1" Text="رفض" BackgroundColor="#B42318" TextColor="White" Clicked="OnRejectClicked" IsVisible="False" />
                </Grid>
            </VerticalStackLayout>

            <ActivityIndicator x:Name="BusyIndicator" Color="#0B6B87" IsVisible="False" IsRunning="False" />
            <Label x:Name="MessageLabel" TextColor="#B42318" HorizontalTextAlignment="Center" IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
