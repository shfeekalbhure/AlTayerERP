<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlTayerERP.Mobile.Office.NewVoucherPage"
             FlowDirection="RightToLeft"
             BackgroundColor="#F6F8FB">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">
            <Label x:Name="PeriodLabel" TextColor="#0B6B87" FontAttributes="Bold" />
            <Button x:Name="RefreshReferencesButton"
                    Text="تحديث القوائم ↻"
                    HeightRequest="44"
                    BackgroundColor="#18794E"
                    TextColor="White"
                    CornerRadius="10"
                    Clicked="OnRefreshReferencesClicked" />
            <Label x:Name="ReferencesStatusLabel"
                   Text="اضغط تحديث القوائم للتحقق من البيانات."
                   FontSize="12"
                   TextColor="#7A8896"
                   HorizontalTextAlignment="Center" />

            <Label Text="تاريخ السند" FontAttributes="Bold" TextColor="#17324D" />
            <DatePicker x:Name="VoucherDatePicker" BackgroundColor="White" TextColor="#17324D" />

            <Label Text="الصندوق أو البنك" FontAttributes="Bold" TextColor="#17324D" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Picker x:Name="SourcePicker" Title="اختر الصندوق أو البنك" BackgroundColor="White" TextColor="#17324D" ItemDisplayBinding="{Binding DisplayName}" />
                <Button x:Name="SourceSearchButton" Grid.Column="1" Text="بحث 🔍" WidthRequest="88" BackgroundColor="#0B6B87" TextColor="White" Clicked="OnSelectSourceClicked" />
            </Grid>
            <Label x:Name="SourceHelpLabel" Text="يمكن الاختيار مباشرة من المنسدلة أو البحث بالاسم." FontSize="12" TextColor="#7A8896" />

            <Label Text="الطرف" FontAttributes="Bold" TextColor="#17324D" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Picker x:Name="PartyPicker" Title="اختر الطرف - اختياري" BackgroundColor="White" TextColor="#17324D" ItemDisplayBinding="{Binding DisplayName}" SelectedIndexChanged="OnPartyChanged" />
                <Button x:Name="PartySearchButton" Grid.Column="1" Text="بحث 🔍" WidthRequest="88" BackgroundColor="#0B6B87" TextColor="White" Clicked="OnSelectPartyClicked" />
            </Grid>
            <Entry x:Name="PartyNameEntry" Placeholder="استلمنا من" BackgroundColor="White" TextColor="#17324D" PlaceholderColor="#7A8896" />

            <Label Text="طريقة السداد" FontAttributes="Bold" TextColor="#17324D" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Picker x:Name="PaymentMethodPicker" Title="اختر طريقة السداد" BackgroundColor="White" TextColor="#17324D" ItemDisplayBinding="{Binding DisplayName}" />
                <Button x:Name="PaymentMethodSearchButton" Grid.Column="1" Text="بحث 🔍" WidthRequest="88" BackgroundColor="#0B6B87" TextColor="White" Clicked="OnSelectPaymentMethodClicked" />
            </Grid>

            <Entry x:Name="ReferenceEntry" Placeholder="رقم المرجع - اختياري" BackgroundColor="White" TextColor="#17324D" PlaceholderColor="#7A8896" />
            <Editor x:Name="DescriptionEditor" Placeholder="البيان" BackgroundColor="White" TextColor="#17324D" PlaceholderColor="#7A8896" MinimumHeightRequest="80" AutoSize="TextChanges" />

            <Label Text="إضافة سطر محاسبي" FontSize="18" FontAttributes="Bold" TextColor="#17324D" Margin="0,8,0,0" />

            <Label Text="الحساب المقابل" FontAttributes="Bold" TextColor="#17324D" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Picker x:Name="AccountPicker" Title="اختر الحساب المقابل" BackgroundColor="White" TextColor="#17324D" ItemDisplayBinding="{Binding DisplayName}" />
                <Button x:Name="AccountSearchButton" Grid.Column="1" Text="بحث 🔍" WidthRequest="88" BackgroundColor="#0B6B87" TextColor="White" Clicked="OnSelectAccountClicked" />
            </Grid>

            <Label Text="مركز التكلفة" FontAttributes="Bold" TextColor="#17324D" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Picker x:Name="CostCenterPicker" Title="اختر مركز التكلفة - اختياري" BackgroundColor="White" TextColor="#17324D" ItemDisplayBinding="{Binding DisplayName}" />
                <Button x:Name="CostCenterSearchButton" Grid.Column="1" Text="بحث 🔍" WidthRequest="88" BackgroundColor="#0B6B87" TextColor="White" Clicked="OnSelectCostCenterClicked" />
            </Grid>

            <Label Text="العملة" FontAttributes="Bold" TextColor="#17324D" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Picker x:Name="CurrencyPicker" Title="اختر العملة" BackgroundColor="White" TextColor="#17324D" ItemDisplayBinding="{Binding DisplayName}" SelectedIndexChanged="OnCurrencyChanged" />
                <Button x:Name="CurrencySearchButton" Grid.Column="1" Text="بحث 🔍" WidthRequest="88" BackgroundColor="#0B6B87" TextColor="White" Clicked="OnSelectCurrencyClicked" />
            </Grid>

            <Entry x:Name="ExchangeRateEntry" Placeholder="سعر الصرف" Keyboard="Numeric" BackgroundColor="White" TextColor="#17324D" />
            <Entry x:Name="ForeignAmountEntry" Placeholder="المبلغ الأجنبي" Keyboard="Numeric" Text="0" BackgroundColor="White" TextColor="#17324D" TextChanged="OnForeignAmountChanged" />
            <Entry x:Name="LocalAmountEntry" Placeholder="المبلغ المحلي" Keyboard="Numeric" BackgroundColor="White" TextColor="#17324D" />
            <Editor x:Name="LineDescriptionEditor" Placeholder="وصف السطر" BackgroundColor="White" TextColor="#17324D" PlaceholderColor="#7A8896" MinimumHeightRequest="65" />
            <Button x:Name="AddLineButton" Text="+ إضافة السطر" BackgroundColor="#0B6B87" TextColor="White" CornerRadius="12" HeightRequest="48" Clicked="OnAddLineClicked" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <Label Text="تفاصيل السند" FontSize="18" FontAttributes="Bold" TextColor="#17324D" />
                <Label x:Name="TotalLabel" Grid.Column="1" Text="الإجمالي: 0.00" FontAttributes="Bold" TextColor="#17324D" />
            </Grid>

            <CollectionView x:Name="LinesList" SelectionMode="None" HeightRequest="280">
                <CollectionView.EmptyView>
                    <Label Text="لم تتم إضافة أسطر بعد." HorizontalTextAlignment="Center" TextColor="#7A8896" Padding="12" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="12" Stroke="#D9E2EC" BackgroundColor="White" StrokeShape="RoundRectangle 12">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4">
                                <Label Text="{Binding AccountDisplay}" FontAttributes="Bold" TextColor="#17324D" />
                                <Button Grid.Column="1" Text="حذف" FontSize="12" BackgroundColor="#B42318" TextColor="White" CommandParameter="{Binding}" Clicked="OnRemoveLineClicked" />
                                <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding CurrencyDisplay}" FontSize="12" TextColor="#7A8896" />
                                <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding CostCenterDisplay}" FontSize="12" TextColor="#7A8896" />
                                    <Label Grid.Column="1" Text="{Binding LocalAmount, StringFormat='{0:N2}'}" FontAttributes="Bold" TextColor="#17324D" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button x:Name="SaveButton" Text="حفظ مسودة" HeightRequest="52" CornerRadius="12" BackgroundColor="#17324D" TextColor="White" Clicked="OnSaveClicked" />
            <ActivityIndicator x:Name="BusyIndicator" Color="#0B6B87" IsVisible="False" IsRunning="False" />
            <Label x:Name="StatusLabel" IsVisible="False" HorizontalTextAlignment="Center" TextColor="#B42318" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
